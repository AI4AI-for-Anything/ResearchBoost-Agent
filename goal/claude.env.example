# Model access for the Claude Code agent. Copy to goal/claude.env (git-ignored) and fill in one of the first three.
# sandbox.sh passes these into the sandbox. setup_home.sh writes this file itself when one of them is set in your
# shell, and uses this host's Claude Code login when none is.
ANTHROPIC_API_KEY=
# or a long-lived token from `claude setup-token` (a Claude subscription on a headless host)
CLAUDE_CODE_OAUTH_TOKEN=
# or a bearer token for a gateway, with ANTHROPIC_BASE_URL
ANTHROPIC_AUTH_TOKEN=
# Optional: a gateway or proxy in front of the Anthropic API.
ANTHROPIC_BASE_URL=
# Optional: the model to run. Empty = the Claude Code default.
ANTHROPIC_MODEL=
